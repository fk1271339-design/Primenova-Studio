# ═══════════════════════════════════════════════════════════════
# PrimeNova Studio — Environment Variables (.env)
# Is file ko copy karke ".env" naam do, phir values bharo.
# ═══════════════════════════════════════════════════════════════

# ─── MongoDB ────────────────────────────────────────────────────
MONGO_PORT=27017
MONGODB_ROOT_USERNAME=admin
MONGODB_ROOT_PASSWORD=change-me
MONGODB_DATABASE=primenova_db
MONGO_EXPRESS_PORT=8081

# ─── Ports ──────────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=80

# ─── Security (JWT) ─────────────────────────────────────────────
# Production me lambe random secret use karo (min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=86400000

# ─── Email verification / resend (anti-spam) ────────────────────
VERIFICATION_TOKEN_EXPIRY_HOURS=24
EMAIL_RESEND_COOLDOWN_SECONDS=60

# ─── OAuth — Google ─────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Google Console me Authorized redirect URI:
#   dev:  http://localhost:8080/login/oauth2/code/google
#   prod: https://api.primenova.studio/login/oauth2/code/google

# ─── OAuth — GitHub ─────────────────────────────────────────────
# https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# GitHub OAuth App me Callback URL:
#   dev:  http://localhost:8080/login/oauth2/code/github
#   prod: https://api.primenova.studio/login/oauth2/code/github

# ─── SMTP (Gmail App Password) ──────────────────────────────────
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=you@gmail.com

# ─── IP Geolocation ────────────────────────────────────────────
# Free keyless API (ipwho.is by default, 10k req/month). Set GEO_LOOKUP_ENABLED=false
# to disable entirely (offline dev / privacy). Swap GEO_API_URL for another provider.
GEO_API_URL=https://ipwho.is/
GEO_LOOKUP_ENABLED=true

# ─── App URLs (single-server mode) ─────────────────────────────
# Frontend URL — OAuth callback + email links isi se bante hain.
# Single-server: frontend + backend dono ek hi :8080 pe hain.
# Alag setup me public URL yahan daalo (e.g. https://primenova.studio).
FRONTEND_URL=http://localhost:8080
# Backend ke liye allowed CORS origins (comma separated).
# Same-origin calls ko CORS ki zaroorat nahi — 8080 hi enough hai.
CORS_ORIGINS=http://localhost:8080
# Admin notifications jis email pe jayengi
ADMIN_EMAIL=hello@primenova.studio

# ─── Frontend build (Vite) ──────────────────────────────────────
# API base — same-origin "" ka matlab /api hi hota hai; hamesha rakho
VITE_API_URL=/api
# Backend public origin — OAuth login redirects ke liye.
# Empty = same-origin (single-server). Alag backend ho toh public
# origin daalo, e.g. https://api.primenova.studio
# NOTE: docker-compose (multi-container) mode me yeh EMPTY nahi ho
# sakta — waha public URL set karna zaroori hai (compose :? check karta hai).
VITE_BACKEND_ORIGIN=
